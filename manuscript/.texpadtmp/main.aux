\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textcolor {blue}{The structure shared by every simulation in this section, built up over three panels; panel (c) is the whole structure. Only $U$ is hidden, drawn in gray. (a) Blocks $W_1$, $W_2$, $W_3$ are noisy measurements of $U$. (b) Block $W_5$ is a noisy measurement of $U$ together with two coordinates that act on their own, one causing treatment without affecting the outcome and one confounding treatment and outcome. (c) Block $W_4$ is a noisy measurement of $U$ shifted by the treatment-causing coordinate of $W_5$.}}}{20}{figure.caption.4}\protected@file@percent }
\newlabel{fig:exp-design}{{3}{20}{\textcolor {blue}{The structure shared by every simulation in this section, built up over three panels; panel (c) is the whole structure. Only $U$ is hidden, drawn in gray. (a) Blocks $W_1$, $W_2$, $W_3$ are noisy measurements of $U$. (b) Block $W_5$ is a noisy measurement of $U$ together with two coordinates that act on their own, one causing treatment without affecting the outcome and one confounding treatment and outcome. (c) Block $W_4$ is a noisy measurement of $U$ shifted by the treatment-causing coordinate of $W_5$.}}{figure.caption.4}{}}
